{
  "name": "smart-document-capture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "try:extract": "tsx --conditions=react-server --env-file=.env.local scripts/try-extract.mts",
    "try:propose": "tsx --conditions=react-server --env-file=.env.local scripts/try-propose.mts",
    "retry:doc": "tsx --conditions=react-server --env-file=.env.local scripts/retry-doc.mts",
    "fixtures:build": "node scripts/build-demo-fixtures.mjs",
    "check:classification": "tsx --conditions=react-server --env-file=.env.local scripts/check-classification.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@supabase/supabase-js": "^2.117.3",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "next": "16.4.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}

# Copy to .env.local for local development.
# On Vercel these are set in Project Settings → Environment Variables.

# Shared login (ADR 0002). Use admin / 1234 locally only.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="1234"
# Signs the session cookie. Any long random string.
SESSION_SECRET=""

# Supabase: added automatically by the Vercel Supabase integration.
# Pull them with the Vercel CLI or copy from the Vercel dashboard.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Used by `npm run db:migrate`.
POSTGRES_URL_NON_POOLING=""

# Claude API (needed from ticket 03).
ANTHROPIC_API_KEY=""
# Optional overrides; defaults are claude-opus-5-5 / claude-haiku-5-5 / 4.
# AI_EXTRACTION_MODEL=""
# AI_CLASSIFICATION_MODEL=""
# EXTRACTION_CONCURRENCY=""
